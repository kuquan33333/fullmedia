{
  "name": "fullmedia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @fullmedia/api dev",
    "build:api": "pnpm --filter @fullmedia/api build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:providers": "tsc -p packages/providers/tsconfig.json --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:providers": "vitest run packages/providers",
    "verify": "pnpm typecheck && pnpm test && pnpm build:api"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
