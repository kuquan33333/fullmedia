{
  "name": "fullmedia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @fullmedia/api dev",
    "build:api": "pnpm --filter @fullmedia/api build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "typecheck:providers": "pnpm --filter @fullmedia/providers typecheck",
    "typecheck:api": "pnpm --filter @fullmedia/api typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:providers": "pnpm --filter @fullmedia/providers test",
    "verify": "pnpm typecheck && pnpm test && pnpm build:api"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
