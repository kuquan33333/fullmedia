# Supabase/PostgreSQL server connection string. Prefer the Supabase pooler URL in Vercel.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require

# Keep small on serverless. Increase only after observing DB connection usage.
FULLMEDIA_DB_POOL_MAX=5

# Provider registry config cache in the API process.
FULLMEDIA_PROVIDER_REGISTRY_TTL_MS=30000

# Protect internal operational endpoints such as provider health probes.
FULLMEDIA_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Optional per-provider overrides. DB remains the source of truth.
# FULLMEDIA_PROVIDER_OPHIM_ENABLED=true
# FULLMEDIA_PROVIDER_OPHIM_BASE_URL=https://ophim1.com
# FULLMEDIA_PROVIDER_OPHIM_TIMEOUT_MS=8000
# FULLMEDIA_PROVIDER_KKPHIM_ENABLED=true
# FULLMEDIA_PROVIDER_KKPHIM_BASE_URL=https://phimapi.com
