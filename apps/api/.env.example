# Supabase/PostgreSQL server connection string. Prefer the Supabase transaction pooler URL in Vercel.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?sslmode=require

# Supabase recommends one app-side connection per warm serverless instance by default.
FULLMEDIA_DB_POOL_MAX=1

# Provider registry config cache in the API process.
FULLMEDIA_PROVIDER_REGISTRY_TTL_MS=30000

# Canonical catalog/provider-ref caches.
FULLMEDIA_CANONICAL_CACHE_TTL_MS=600000
FULLMEDIA_PROVIDER_REF_CACHE_TTL_MS=600000
FULLMEDIA_CANONICAL_CACHE_MAX_ENTRIES=2000
FULLMEDIA_PROVIDER_DISCOVERY_LIMIT=10
FULLMEDIA_PROVIDER_DISCOVERY_THRESHOLD=0.8

# Movie response caches. Playback descriptors are intentionally never cached.
FULLMEDIA_MOVIE_LIST_CACHE_TTL_MS=60000
FULLMEDIA_MOVIE_SEARCH_CACHE_TTL_MS=30000
FULLMEDIA_MOVIE_DETAIL_CACHE_TTL_MS=300000
FULLMEDIA_MOVIE_EPISODES_CACHE_TTL_MS=120000

# Protect internal operational endpoints such as provider health probes.
FULLMEDIA_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Optional per-provider overrides. DB remains the source of truth.
# FULLMEDIA_PROVIDER_OPHIM_ENABLED=true
# FULLMEDIA_PROVIDER_OPHIM_BASE_URL=https://ophim1.com
# FULLMEDIA_PROVIDER_OPHIM_TIMEOUT_MS=8000
# FULLMEDIA_PROVIDER_KKPHIM_ENABLED=true
# FULLMEDIA_PROVIDER_KKPHIM_BASE_URL=https://phimapi.com
