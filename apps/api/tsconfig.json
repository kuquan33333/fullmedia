{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"],
  "references": [
    { "path": "../../packages/providers" }
  ]
}
